# Copy to .env and adjust. Every variable has a compose default, so an
# empty .env (or none at all) works.
POSTGRES_DB=fga
POSTGRES_HOST=localhost
POSTGRES_PASSWORD=password
POSTGRES_PORT=5432
POSTGRES_USER=fga
PREFIX=fga4postgres

# The OpenFGA oracle container (conformance reference).
OPENFGA_GRPC_PORT=8081
OPENFGA_HTTP_PORT=8080
